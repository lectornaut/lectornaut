{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lectornaut",
  "version": "0.0.0",
  "identifier": "com.lectornaut.com",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lectornaut",
        "width": 1200,
        "height": 720,
        "minHeight": 480,
        "minWidth": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": true,
        "transparent": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Business",
    "copyright": "Copyright © 2025 Lectornaut",
    "license": "MIT",
    "fileAssociations": [
      {
        "description": "Open in Lectornaut",
        "ext": ["lectornaut"],
        "mimeType": "text/plain"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.png": "icons/icon.png"
    },
    "macOS": {
      "dmg": {
        "background": "icons/dmg/background.png"
      },
      "files": {
        "Resources/Assets.car": "resources/Assets.car"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schema": "lectornaut",
      "desktop": {
        "schemes": ["lectornaut"]
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMDExODg1MURDOTlGM0YKUldRL244a2RoUmdCNjJPMEVvaEpaYUUvWDVYWTBTcVdYMEg5NllBTUpNQVIwUGRZR0J0Wnc5Z0QK",
      "endpoints": [
        "https://github.com/lectornaut/lectornaut/releases/latest/download/latest.json"
      ]
    }
  }
}
