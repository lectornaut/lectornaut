<mjml>
  <mj-head>
    <mj-title>Welcome to Lectornaut</mj-title>
    <mj-preview
      >We're thrilled to have you on board! Let's get you started.</mj-preview
    >
    <mj-attributes>
      <mj-all
        font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"
      ></mj-all>
      <mj-text font-size="14px" line-height="24px" color="black"></mj-text>
      <mj-button
        font-size="14px"
        color="white"
        background-color="black"
        border-radius="8px"
        font-weight="bold"
      ></mj-button>
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-include path="../partials/header.mjml" />

    <mj-section padding="0">
      <mj-column>
        <mj-text font-size="16px" font-weight="bold">
          Welcome to Lectornaut
        </mj-text>

        <mj-text>Hi {{ displayName }},</mj-text>

        <mj-text>
          We're thrilled to have you on board. Lectornaut is designed to help
          you and your team organize your reading, capture insights, and share
          knowledge efficiently.
        </mj-text>

        <mj-button href="{{ ctaUrl }}" align="left">
          Start Exploring
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>
