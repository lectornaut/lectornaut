<mjml>
  <mj-head>
    <mj-title>Membership Update</mj-title>
    <mj-preview>You have been removed from {{ teamName }}.</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"
      ></mj-all>
      <mj-text font-size="14px" line-height="24px" color="black"></mj-text>
      <mj-button
        font-size="14px"
        color="white"
        background-color="black"
        border-radius="8px"
        font-weight="bold"
      ></mj-button>
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-include path="../partials/header.mjml" />

    <mj-section padding="0">
      <mj-column>
        <mj-text font-size="16px" font-weight="bold">
          Membership Update
        </mj-text>

        <mj-text> Hello, </mj-text>

        <mj-text>
          You have been removed from <strong>{{ teamName }}</strong
          >. If you believe this was a mistake, please contact your team
          administrator.
        </mj-text>

        <mj-button href="{{ ctaUrl }}" align="left">
          View Your Teams
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>
