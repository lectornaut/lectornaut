<mjml>
  <mj-head>
    <mj-title>You've been invited to join {{ teamName }}</mj-title>
    <mj-preview>Join your team on Lectornaut.</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"
      ></mj-all>
      <mj-text font-size="14px" line-height="24px" color="black"></mj-text>
      <mj-button
        font-size="14px"
        color="white"
        background-color="black"
        border-radius="8px"
        font-weight="bold"
      ></mj-button>
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-include path="../partials/header.mjml" />

    <mj-section padding="0">
      <mj-column>
        <mj-text font-size="16px" font-weight="bold">
          Join {{ teamName }}
        </mj-text>

        <mj-text> Hello, </mj-text>

        <mj-text>
          <strong>{{ inviterName }}</strong> ({{ inviterEmail }}) has invited
          you to join <strong>{{ teamName }}</strong> with the role
          <strong>{{ roleLabel }}</strong>. Collaborate, share insights, and
          organize your knowledge together.
        </mj-text>

        <mj-button href="{{ ctaUrl }}" align="left">
          Accept Invitation
        </mj-button>

        <mj-text font-size="12px" color="gray">
          If you did not expect this invitation, you can safely ignore this
          email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>
