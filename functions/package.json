  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.28.0",
    "@genkit-ai/google-genai": "^1.28.0",
    "@google-cloud/functions-framework": "^5.0.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "genkit": "^1.28.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.9.3"
  }
}
