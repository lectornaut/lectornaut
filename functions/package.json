{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "rimraf lib src/shared",
    "copy:shared": "cpy \"../shared/**/*.ts\" src/shared",
    "build": "pnpm run clean && pnpm run copy:shared && tsc && cpy \"src/**/*.mjml\" lib",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck",
    "test": "node --test",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.32.0",
    "@genkit-ai/google-genai": "^1.32.0",
    "@google-cloud/functions-framework": "5.0.2",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "genkit": "^1.32.0",
    "handlebars": "^4.7.9",
    "mjml": "^5.0.1",
    "postmark": "^4.0.7",
    "stripe": "^22.0.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/mjml": "^5.0.0",
    "cpy-cli": "^7.0.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
