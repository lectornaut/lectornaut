{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "clean": "rimraf lib",
    "build": "pnpm run clean && tsc && cpy \"src/**/*.mjml\" lib",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck",
    "test": "node --test",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.29.0",
    "@genkit-ai/google-genai": "^1.29.0",
    "@google-cloud/functions-framework": "5.0.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.0.6",
    "genkit": "^1.29.0",
    "handlebars": "^4.7.8",
    "mjml": "^4.18.0",
    "postmark": "^4.0.7"
  },
  "devDependencies": {
    "@types/mjml": "^4.7.4",
    "cpy-cli": "^7.0.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.8.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
