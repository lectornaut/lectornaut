{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsc && cpy \"src/**/*.mjml\" lib",
    "build:watch": "tsc --watch",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.28.0",
    "@genkit-ai/google-genai": "^1.28.0",
    "@google-cloud/functions-framework": "5.0.1",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5",
    "genkit": "^1.28.0",
    "handlebars": "^4.7.8",
    "mjml": "^4.18.0",
    "postmark": "^4.0.5"
  },
  "devDependencies": {
    "@types/mjml": "^4.7.4",
    "cpy-cli": "^7.0.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.9.3"
  }
}
