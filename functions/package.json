{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "clean": "rimraf ../functions-deploy",
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint:types": "tsc --noEmit",
    "lint:code": "eslint \"./src/**/*.{js,ts,cjs,mjs}\"",
    "lint:code:fix": "eslint \"./src/**/*.{js,ts,cjs,mjs}\" --fix",
    "lint:format": "prettier . --check",
    "lint:format:fix": "prettier . --write",
    "lint": "pnpm lint:types && pnpm lint:code && pnpm lint:format",
    "lint:fix": "pnpm lint:types && pnpm lint:code:fix && pnpm lint:format:fix",
    "test": "node --test --experimental-strip-types",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "../functions-deploy/index.js",
  "dependencies": {
    "@genkit-ai/anthropic": "^0.3.0",
    "@genkit-ai/compat-oai": "1.40.1",
    "@genkit-ai/firebase": "1.40.1",
    "@genkit-ai/google-genai": "1.40.1",
    "@google-cloud/functions-framework": "5.0.5",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "7.3.2-rc.0",
    "genkit": "1.40.1",
    "handlebars": "^4.7.9",
    "mjml": "^5.4.0",
    "postmark": "^5.1.0",
    "stripe": "^22.3.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lectornaut/shared": "workspace:*",
    "@types/mjml": "^5.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "^15.24.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
