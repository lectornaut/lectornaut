{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"],
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["./src/**/*"],
  // Unit tests run via `node --test --experimental-strip-types` and import
  // their target module with a `.ts` specifier (the only form this Node
  // version's type-stripping resolves). Excluding them keeps that `.ts`
  // specifier from tripping `tsc --noEmit` under `moduleResolution: nodenext`.
  // They're validated by being run, not type-checked — and esbuild never
  // bundles them (it follows imports from `index.ts` only).
  "exclude": ["src/**/*.test.ts"]
}
