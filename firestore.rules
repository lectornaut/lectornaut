rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function membershipPath(teamId, userId) {
      return /databases/$(database)/documents/teams/$(teamId)/memberships/$(userId);
    }

    function isTeamMember(teamId) {
      return isSignedIn() && exists(membershipPath(teamId, request.auth.uid));
    }

    function teamRole(teamId) {
      return get(membershipPath(teamId, request.auth.uid)).data.role;
    }

    function isTeamAdmin(teamId) {
      return isTeamMember(teamId)
        && teamRole(teamId) in ["owner", "admin"];
    }

    function canManageWorkspaceContent(teamId) {
      return isTeamMember(teamId)
        && teamRole(teamId) in ["owner", "admin", "member"];
    }

    function isWorkspaceNodeScope(scope) {
      return scope in ["code", "write"];
    }

    function roomPath(contentId) {
      return /databases/$(database)/documents/signaling/$(contentId);
    }

    function canViewRoom(contentId) {
      return isSignedIn()
        && exists(roomPath(contentId))
        && get(roomPath(contentId)).data.teamId is string
        && isTeamMember(get(roomPath(contentId)).data.teamId);
    }

    function isInvitationRecipient(invitationEmail) {
      return isSignedIn()
        && request.auth.token.email is string
        && invitationEmail is string
        && invitationEmail == request.auth.token.email;
    }

    function isValidNotificationStatus(status) {
      return status in ["inbox", "saved", "done"];
    }

    function canUpdateOwnMembershipProfile(teamId, userId) {
      return isSelf(userId)
        && isTeamMember(teamId)
        && request.resource.data.userId == userId
        && request.resource.data.teamId == teamId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "user",
             "updatedAt"
           ]);
    }

    // Supports collectionGroup("memberships").where("userId", "==", request.auth.uid)
    // used to render the signed-in user's team list.
    function isOwnMembershipDoc() {
      return isSignedIn()
        && resource.data.userId is string
        && resource.data.userId == request.auth.uid;
    }

    function hasValidSnapshotPayload(contentId) {
      return isSignedIn()
        && request.resource.data.contentId == contentId
        && request.resource.data.teamId is string
        && request.resource.data.workspaceId is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.ydocBase64 is string;
    }

    function canCreateSnapshot(contentId) {
      return hasValidSnapshotPayload(contentId)
        && canManageWorkspaceContent(request.resource.data.teamId);
    }

    function canUpdateSnapshot(contentId) {
      return hasValidSnapshotPayload(contentId)
        && resource.data.teamId is string
        && resource.data.workspaceId is string
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.contentId == resource.data.contentId
        && canManageWorkspaceContent(resource.data.teamId);
    }

    match /snapshots/{contentId} {
      allow read: if resource.data.teamId is string
                  && isTeamMember(resource.data.teamId);
      allow create: if canCreateSnapshot(contentId);
      allow update: if canUpdateSnapshot(contentId);
      allow delete: if false;
    }

    match /signaling/{contentId} {
      allow read: if resource.data.teamId is string
                  && isTeamMember(resource.data.teamId);
      allow write: if false;

      match /peers/{peerId} {
        allow read: if canViewRoom(contentId);
        allow write: if false;
      }

      match /signals/{signalId} {
        allow read: if canViewRoom(contentId);
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow create: if isSelf(userId) && request.resource.data.uid == userId;
      allow read: if isSelf(userId) || resource.data.isPublic == true;
      allow update, delete: if isSelf(userId);

      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow update: if isSelf(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           "read",
                           "status"
                         ])
                      && request.resource.data.read is bool
                      && isValidNotificationStatus(request.resource.data.status);
        allow create: if false;
        allow delete: if isSelf(userId);
      }

      match /notificationPreferences/{preferenceId} {
        allow read, write: if isSelf(userId);
      }

      match /layout/{layoutId} {
        allow read, write: if isSelf(userId)
          && layoutId in ["navigation", "theme"];
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(["uid", "createdAt"])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(["uid", "createdAt"])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow write: if false;

      match /memberships/{userId} {
        allow read: if isTeamMember(teamId) || isOwnMembershipDoc();
        // Create is handled by Cloud Functions (invite/accept flow)
        allow create: if false;
        // Update is allowed only for syncing user profile data (name, photo)
        allow update: if canUpdateOwnMembershipProfile(teamId, userId);
        allow delete: if false;

        match /workspaces/{workspaceId} {
          allow read: if isSelf(userId) && isTeamMember(teamId);
          allow write: if false;

          match /layout/{layoutId} {
            allow read, write: if isSelf(userId)
              && isTeamMember(teamId)
              && layoutId == "tabs";
          }
        }
      }

      match /workspaces/{workspaceId} {
        allow read: if isTeamMember(teamId);
        allow write: if false;

        match /{scope}/{nodeId} {
          allow read: if isWorkspaceNodeScope(scope) && isTeamMember(teamId);
          allow write: if false;
        }

        match /memberships/{userId} {
          // Supports collectionGroup("memberships").where("userId", "==", request.auth.uid)
          // which may include workspace-level memberships alongside team-level memberships.
          allow read: if (isSelf(userId) && isTeamMember(teamId)) || isOwnMembershipDoc();
          allow write: if false;
        }
      }
    }

    match /invitations/{invitationId} {
      allow read: if isSignedIn()
                  && resource.data.teamId is string
                  && (
                    isInvitationRecipient(resource.data.email)
                    || isTeamAdmin(resource.data.teamId)
                  );
      allow write: if false;
    }

    match /logs/{logId} {
      allow read: if resource.data.teamId is string
                  && isTeamAdmin(resource.data.teamId);
      allow write: if false;
    }

    // Global fallback for collectionGroup("memberships") queries.
    // If the queried membership document belongs to the signed-in user,
    // allow read even when the document lives under another memberships path.
    match /{path=**}/memberships/{membershipId} {
      allow read: if isOwnMembershipDoc();
      allow write: if false;
    }

    // Default deny for all non-explicit collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
