rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function membershipPath(teamId, userId) {
      return /databases/$(database)/documents/teams/$(teamId)/memberships/$(userId);
    }

    function isTeamMember(teamId) {
      return isSignedIn() && exists(membershipPath(teamId, request.auth.uid));
    }

    function teamRole(teamId) {
      return get(membershipPath(teamId, request.auth.uid)).data.role;
    }

    function isTeamAdmin(teamId) {
      return isTeamMember(teamId)
        && teamRole(teamId) in ["owner", "admin"];
    }

    function canManageMembers(teamId) {
      return isTeamAdmin(teamId);
    }

    function canReadAuditLogs(teamId) {
      return isTeamMember(teamId)
        && teamRole(teamId) in ["owner", "admin"];
    }

    // True when the calling user is explicitly excluded (a non-member) from this
    // workspace — set by assignWorkspaceRole({excluded:true}). It is a get() on a
    // FIXED doc (the caller's own override for this workspace), so it does NOT
    // vary per result document and is therefore safe to use in `list` rules.
    function isWorkspaceExcluded(teamId, workspaceId) {
      return exists(/databases/$(database)/documents/teams/$(teamId)/memberships/$(request.auth.uid)/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/teams/$(teamId)/memberships/$(request.auth.uid)/workspaces/$(workspaceId)).data.get("excluded", false) == true;
    }

    function isWorkspaceNodeScope(scope) {
      return scope in ["code", "write"];
    }

    function botSessionPath(teamId, workspaceId, sessionId) {
      return /databases/$(database)/documents/teams/$(teamId)/workspaces/$(workspaceId)/botSessions/$(sessionId);
    }

    // Mirror the botSessions read predicate for attachment-subcollection reads
    // so a private chat's attachments aren't enumerable by other members. The
    // repeated get() is cached within one rule evaluation (single read).
    function canReadBotSession(teamId, workspaceId, sessionId) {
      return isTeamMember(teamId)
        && (
          get(botSessionPath(teamId, workspaceId, sessionId)).data.ownerUid == request.auth.uid
          || get(botSessionPath(teamId, workspaceId, sessionId)).data.visibility == "shared"
          || isTeamAdmin(teamId)
        );
    }

    function roomPath(contentId) {
      return /databases/$(database)/documents/signaling/$(contentId);
    }

    function canViewRoom(contentId) {
      return isSignedIn()
        && get(roomPath(contentId)).data.teamId is string
        && isTeamMember(get(roomPath(contentId)).data.teamId)
        && !isWorkspaceExcluded(
             get(roomPath(contentId)).data.teamId,
             get(roomPath(contentId)).data.workspaceId
           );
    }

    function isInvitationRecipient(invitationEmail) {
      return isSignedIn()
        && request.auth.token.email is string
        && invitationEmail is string
        && invitationEmail.trim().lower() == request.auth.token.email.trim().lower();
    }

    function isValidSyncMutationType(type) {
      return type in ["set", "update", "delete"];
    }

    function isValidSyncOperationCreate(userId, operationId) {
      return request.resource.data.id == operationId
        && request.resource.data.userId == userId
        && request.resource.data.clientId is string
        && request.resource.data.source is string
        && request.resource.data.targetPath is string
        && isValidSyncMutationType(request.resource.data.type)
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp;
    }

    function isValidSyncOperationRetry(userId) {
      return resource.data.userId == userId
        && resource.data.status == "pending"
        && request.resource.data.status == "pending"
        // Immutable operation identity
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.source == resource.data.source
        && request.resource.data.targetPath == resource.data.targetPath
        && request.resource.data.type == resource.data.type
        && request.resource.data.data == resource.data.data
        && request.resource.data.merge == resource.data.merge
        && request.resource.data.baseVersion == resource.data.baseVersion;
    }

    function canUpdateOwnMembershipProfile(teamId, userId) {
      return isSelf(userId)
        && isTeamMember(teamId)
        && request.resource.data.userId == userId
        && request.resource.data.teamId == teamId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "user",
             "updatedAt"
           ]);
    }

    // Supports collectionGroup("memberships").where("userId", "==", request.auth.uid)
    // used to render the signed-in user's team list.
    function isOwnMembershipDoc() {
      return isSignedIn()
        && resource.data.userId is string
        && resource.data.userId == request.auth.uid;
    }

    function isNullableStringField(data, field) {
      return data[field] is string || data[field] == null;
    }

    function isOptionalBoolField(data, field) {
      return data[field] is bool || data[field] == null;
    }

    function isValidUserProfileCreate(userId) {
      return request.resource.data.keys().hasOnly([
               "uid",
               "email",
               "displayName",
               "photoURL",
               "username",
               "isPublic",
               "createdAt",
               "updatedAt"
             ])
        && request.resource.data.uid == userId
        && isNullableStringField(request.resource.data, "email")
        && isNullableStringField(request.resource.data, "displayName")
        && isNullableStringField(request.resource.data, "photoURL")
        && isNullableStringField(request.resource.data, "username")
        && isOptionalBoolField(request.resource.data, "isPublic");
    }

    function isOwnedUserUsernameClaim(data) {
      return data.entityType == "user"
        && data.entityId is string
        && data.entityId == request.auth.uid;
    }

    // Collab ydoc snapshots. Reads stay client-side (the collab loader
    // `getDoc`s the snapshot on open); WRITES are server-only. Every client
    // write flows through the sync engine's outbox — `applySyncOperation` /
    // `onSyncOperationCreated` settle it via `routeSnapshotMutation`
    // (functions/src/syncSettlement.ts), which enforces the payload
    // whitelist, the 1MB `ydocBase64` cap, OCC (`baseVersion`), and the
    // canonical MANAGE_WORKSPACE_CONTENT decision (shared/permissions.ts).
    // The old direct create/update clauses bypassed all four, so they were
    // removed along with their helpers (canCreateSnapshot/canUpdateSnapshot →
    // canManageWorkspaceContentIn).
    match /snapshots/{contentId} {
      allow get: if (!exists(/databases/$(database)/documents/snapshots/$(contentId))
                     && canViewRoom(contentId))
                 || (resource.data.teamId is string
                     && isTeamMember(resource.data.teamId)
                     && !isWorkspaceExcluded(
                          resource.data.teamId,
                          resource.data.workspaceId
                        ));
      allow list: if false;
      allow write: if false;
    }

    match /signaling/{contentId} {
      allow read: if resource.data.teamId is string
                  && isTeamMember(resource.data.teamId);
      allow write: if false;

      match /peers/{peerId} {
        allow read: if canViewRoom(contentId);
        allow write: if false;
      }

      match /signals/{signalId} {
        allow read: if canViewRoom(contentId);
        allow write: if false;
      }

      // Server-relayed agent edits for live application by connected clients.
      // Read for anyone in the room; writes are Cloud-Function-only (the agent
      // node tools write it via the admin SDK).
      match /agentRelay/{docId} {
        allow read: if canViewRoom(contentId);
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow create: if isSelf(userId) && isValidUserProfileCreate(userId);
      allow read: if isSelf(userId) || resource.data.isPublic == true;
      // Root-doc UPDATES are server-only: profile fields sync through the
      // engine's user-root settlement route (functions/src/syncSettlement.ts
      // `validateUserDocumentMutation`) and the account callables
      // (syncCurrentUserAccountProfile / updateUserProfileVisibility). No
      // client path issues a direct root update — device sessions write only
      // the `sessions` subcollection below — so the old
      // `isValidUserProfileUpdate` clause was removed: it bypassed the
      // settlement's field whitelist.
      allow update: if false;
      allow delete: if isSelf(userId);

      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow update: if false;
        allow create: if false;
        allow delete: if false;
      }

      match /layout/{layoutId} {
        allow read: if isSelf(userId)
          && layoutId == "navigation";
        allow write: if false;
      }

      match /settings/{settingId} {
        allow read: if isSelf(userId)
          && settingId in ["notifications", "preferences", "themes", "shortcuts"];
        allow write: if false;
      }

      match /syncOperations/{operationId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId)
                      && isValidSyncOperationCreate(userId, operationId);
        allow update: if isSelf(userId)
                      && isValidSyncOperationRetry(userId);
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isSelf(userId);
        allow create: if false;
        allow update: if isSelf(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           "lastActiveAt"
                         ]);
        allow delete: if isSelf(userId);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(["entityType", "entityId", "createdAt"])
                    && request.resource.data.entityType == "user"
                    && request.resource.data.entityId == request.auth.uid;
      allow update: if isSignedIn()
                    && isOwnedUserUsernameClaim(resource.data)
                    && request.resource.data.keys().hasOnly(["entityType", "entityId", "createdAt"])
                    && request.resource.data.entityType == "user"
                    && request.resource.data.entityId == request.auth.uid;
      allow delete: if isSignedIn()
                    && isOwnedUserUsernameClaim(resource.data);
    }

    match /sso-domains/{domain} {
      allow read: if false;
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId) || resource.data.isPublic == true;
      allow write: if false;

      match /settings/security {
        allow read: if isTeamAdmin(teamId);
        allow write: if false;
      }

      // Agent + tool integrations. The single collection that replaces the
      // agents/tools install maps + custom collections. Member read because
      // chat pickers/sidebar need the agent + tool catalog to render. Writes
      // are callable-only and admin-gated server-side (integrations.ts).
      match /integrations/{integrationId} {
        allow read: if isTeamMember(teamId);
        allow write: if false;
      }

      // Connections: installed external-account apps (doc id == provider key,
      // e.g. "google-calendar"). Member read so the Connections settings
      // section can render install + link state. Writes are callable-only
      // (connections.ts: install/uninstall admin-gated, bindings member-gated).
      //
      // SECURITY: the sibling `bindingSecrets/{uid}` subcollection holds OAuth
      // tokens and DELIBERATELY has no match block — deny-by-default means no
      // client can ever read or write a token. Do not add a match for it.
      match /connections/{provider} {
        allow read: if isTeamMember(teamId);
        allow write: if false;

        // Per-member account links (metadata only: status, email, scopes).
        // Team-readable so the section can show who's linked ("3 members
        // connected") and surface needs-reauth states.
        match /bindings/{userId} {
          allow read: if isTeamMember(teamId);
          allow write: if false;
        }
      }

      // Workflows (team automations) now live UNDER each workspace
      // (teams/{teamId}/workspaces/{workspaceId}/workflows) and are read
      // team-wide via a collectionGroup on the denormalized teamId — see the
      // `/{path=**}/workflows` rule below. Writes stay callable-only (admin SDK).

      // Which predefined presets the team has made available (the Integrations
      // tier of the two-tier model). Doc id is the presetKey. Member read so
      // every workspace's predefined section can render; writes are
      // callable-only (admin-gated — setTeamWorkflowAvailability).
      match /availableWorkflows/{presetKey} {
        allow read: if isTeamMember(teamId);
        allow write: if false;
      }

      // Groups: reusable named bundles of team members ({ name, memberIds[] };
      // NO role lives on the group). Member read so the Settings → Groups list +
      // the WorkspaceDialog provenance ("via {Group}") can render the catalog.
      // Writes are callable-only (admin-gated — createGroup/updateGroup/
      // deleteGroup). The role a group confers is a per-workspace grant stored
      // under each workspace (see `groupGrants` below), never on the group.
      match /groups/{groupId} {
        allow read: if isTeamMember(teamId);
        allow write: if false;
      }

      // Workflow run history now lives UNDER each workspace — see the
      // workflowRuns match in the workspaces block below. Writes stay
      // callable-only (admin SDK).

      // Monthly LLM token-usage counters. Admin-only read (usage/billing
      // views); written only by the server-side metering middleware.
      match /usage/{monthId} {
        allow read: if isTeamAdmin(teamId);
        allow write: if false;
      }

      match /memberships/{userId} {
        allow read: if isTeamMember(teamId) || isOwnMembershipDoc();
        // Create is handled by Cloud Functions (invite/accept flow)
        allow create: if false;
        // Update is allowed only for syncing user profile data (name, photo)
        allow update: if canUpdateOwnMembershipProfile(teamId, userId);
        allow delete: if false;

        match /workspaces/{workspaceId} {
          allow read: if isSelf(userId) && isTeamMember(teamId);
          allow write: if false;

          match /layout/{layoutId} {
            allow read: if isSelf(userId)
              && isTeamMember(teamId)
              && layoutId == "tabs";
            allow write: if false;
          }
        }

        match /settings/{settingId} {
          allow read: if isSelf(userId)
            && isTeamMember(teamId)
            && settingId == "preferences";
          allow write: if false;
        }
      }

      match /workspaces/{workspaceId} {
        // Airtight participation. A member sees a workspace only when they're in
        // its `memberUids` — seeded at creation with the team's humans and kept
        // in sync on invite-accept / member-remove / exclude. The client lists
        // with where("memberUids","array-contains",uid) and this rule requires
        // the same constraint, so an unconstrained list that could surface a
        // workspace the caller isn't in is denied. Excluded members are removed
        // from `memberUids`, so they never receive the doc.
        allow read: if isTeamMember(teamId)
          && request.auth.uid in resource.data.memberUids;
        allow write: if false;

        match /{scope}/{nodeId} {
          allow read: if isWorkspaceNodeScope(scope)
            && isTeamMember(teamId)
            && !isWorkspaceExcluded(teamId, workspaceId);
          allow write: if false;

          match /attachments/{attachmentId} {
            allow read: if isWorkspaceNodeScope(scope)
              && isTeamMember(teamId)
              && !isWorkspaceExcluded(teamId, workspaceId);
            allow write: if false;
          }
        }

        // Bot chat sessions have three visibility modes:
        //   - private (default): owner-only read.
        //   - shared:  any team member can read; owner + full members
        //     (owner/admin/member) write, guests read-only. Write enforcement
        //     lives in Cloud Functions (writes here are always denied).
        //   - public:  reserved for future — rule path not yet implemented.
        // Writes always happen via Cloud Functions (sendBotMessage,
        // updateBotSessionVisibility). Sessions written before the
        // visibility field existed have no value, which evaluates as
        // owner-only here (the shared predicate requires the explicit
        // string match).
        match /botSessions/{sessionId} {
          // Three read paths:
          //   - owner: read your own sessions, any visibility.
          //   - team member: read sessions explicitly shared with the team.
          //   - team admin/owner: read every session in the workspace, used
          //     by the admin-only Sessions tab in Settings.
          // Writes always happen via Cloud Functions (sendBotMessage,
          // archiveBotSession, deleteBotSession, …).
          allow read: if isTeamMember(teamId)
            && !isWorkspaceExcluded(teamId, workspaceId)
            && (
              resource.data.ownerUid == request.auth.uid
              || resource.data.visibility == "shared"
              || isTeamAdmin(teamId)
            );
          allow write: if false;

          // Chat-session attachment metadata — written only via Cloud Functions
          // (admin SDK). Read respects the parent session's visibility so a
          // private chat's files aren't enumerable by other members.
          match /attachments/{attachmentId} {
            allow read: if canReadBotSession(teamId, workspaceId, sessionId)
              && !isWorkspaceExcluded(teamId, workspaceId);
            allow write: if false;
          }
        }

        // Workspace memories — durable, searchable notes. The read predicate
        // is identical to botSessions:
        //   - owner: read your own memories, any visibility.
        //   - team member: read memories explicitly shared with the workspace.
        //   - team admin/owner: read every memory (the management UI).
        // A memory written before the visibility field existed has no value,
        // which evaluates as owner-only (the shared predicate requires the
        // explicit string match). Writes always happen via Cloud Functions
        // (createMemory, updateMemory, …) so embedding + audit + authorize live
        // in the callable path. NOTE: the admin read override is for the
        // management UI only — server-side recall (functions/src/memory.ts)
        // deliberately does NOT use it, so a private memory is never injected
        // into another member's prompt.
        match /memories/{memoryId} {
          allow read: if isTeamMember(teamId)
            && !isWorkspaceExcluded(teamId, workspaceId)
            && (
              resource.data.ownerUid == request.auth.uid
              || resource.data.visibility == "shared"
              || isTeamAdmin(teamId)
            );
          allow write: if false;
        }

        // Workflow run history for this workspace — admin-only read (the Runs
        // page + Settings → Runs). Written only by the dispatcher, event
        // triggers, and worker via the admin SDK.
        match /workflowRuns/{runId} {
          allow read: if isTeamAdmin(teamId)
            && !isWorkspaceExcluded(teamId, workspaceId);
          allow write: if false;
        }

        // Per-(group, workspace) role grant: doc id is the groupId, body is
        // { groupId, role }. This is the ONLY place a group's conferred role
        // lives (the group itself is role-less). Member read (the elevation is
        // not a secret, and the dialog renders granted rows); writes are
        // callable-only (admin-gated, owner-gated for `owner` —
        // assignWorkspaceGroupRole). The functions read path folds these in
        // live; the rules content gate reads the denormalized `groupRole`.
        match /groupGrants/{groupId} {
          allow read: if isTeamMember(teamId);
          allow write: if false;
        }
      }
    }

    match /invitations/{invitationId} {
      allow read: if isSignedIn()
                  && (
                    isInvitationRecipient(resource.data.email)
                    || (
                      resource.data.teamId is string
                      && canManageMembers(resource.data.teamId)
                    )
                  );
      allow write: if false;
    }

    match /logs/{logId} {
      allow read: if resource.data.teamId is string
                  && canReadAuditLogs(resource.data.teamId);
      allow write: if false;
    }

    // Global fallback for collectionGroup("memberships") queries.
    // If the queried membership document belongs to the signed-in user,
    // allow read even when the document lives under another memberships path.
    match /{path=**}/memberships/{membershipId} {
      allow read: if isOwnMembershipDoc();
      allow write: if false;
    }

    // Global rule for collectionGroup("workflows"). Workflows live under each
    // workspace; the client reads a team's workflows team-wide via the
    // denormalized teamId. Member read; writes are callable-only (admin SDK).
    match /{path=**}/workflows/{workflowId} {
      allow read: if isTeamMember(resource.data.teamId);
      allow write: if false;
    }

    // Default deny for all non-explicit collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
