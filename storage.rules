rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /images/users/{userId}/profilePhoto {
      allow create, read, update, delete: if request.auth.uid == userId;
    }
    match /images/teams/{teamId}/profilePhoto {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /images/teams/{teamId}/workspaces/{workspaceId}/profilePhoto {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
