rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath(teamId, userId) {
      return /databases/(default)/documents/teams/$(teamId)/memberships/$(userId);
    }

    function isTeamMember(teamId) {
      return isSignedIn() && firestore.exists(membershipPath(teamId, request.auth.uid));
    }

    function teamRole(teamId) {
      return firestore.get(membershipPath(teamId, request.auth.uid)).data.role;
    }

    function canManageTeamAssets(teamId) {
      return isTeamMember(teamId) && teamRole(teamId) in ["owner", "admin"];
    }

    function canManageWorkspaceContent(teamId) {
      return isTeamMember(teamId)
        && teamRole(teamId) in ["owner", "admin", "member"];
    }

    function isTeamPublic(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data.isPublic == true;
    }

    function isWorkspaceNodeScope(scope) {
      return scope in ["code", "write"];
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.contentType.matches("image/(png|jpeg|gif|webp|avif|bmp|tiff)")
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function isBlockedAttachmentType() {
      return request.resource.contentType.matches("text/html")
        || request.resource.contentType.matches("application/xhtml.*")
        || request.resource.contentType.matches("image/svg.*")
        || request.resource.contentType.matches("application/x-shockwave-flash")
        || request.resource.contentType.matches("text/javascript")
        || request.resource.contentType.matches("application/javascript");
    }

    match /images/users/{userId}/profilePhoto {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isValidImageUpload();
    }

    match /images/teams/{teamId}/profilePhoto {
      allow read: if isTeamMember(teamId) || isTeamPublic(teamId);
      allow create, update: if canManageTeamAssets(teamId) && isValidImageUpload();
      allow delete: if canManageTeamAssets(teamId);
    }

    match /images/teams/{teamId}/workspaces/{workspaceId}/profilePhoto {
      allow read: if isTeamMember(teamId) || isTeamPublic(teamId);
      allow create, update: if canManageTeamAssets(teamId) && isValidImageUpload();
      allow delete: if canManageTeamAssets(teamId);
    }

    match /attachments/teams/{teamId}/workspaces/{workspaceId}/{scope}/{nodeId}/{attachmentId}/{version}/{fileName} {
      allow read: if isWorkspaceNodeScope(scope) && isTeamMember(teamId);
      allow create, update: if isWorkspaceNodeScope(scope)
        && canManageWorkspaceContent(teamId)
        && request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && !isBlockedAttachmentType();
      allow delete: if isWorkspaceNodeScope(scope) && canManageWorkspaceContent(teamId);
    }

    // Chat-session attachments — same root + size/blocked-type rules as node
    // attachments, with `botSessions/{sessionId}` in the `{scope}/{nodeId}`
    // slot. The node rule above denies these (isWorkspaceNodeScope is false),
    // so this dedicated rule grants them. Reads are team-wide here, but the
    // random attachmentId path is only discoverable via the visibility-gated
    // Firestore metadata doc, so private-session files stay effectively private.
    match /attachments/teams/{teamId}/workspaces/{workspaceId}/botSessions/{sessionId}/{attachmentId}/{version}/{fileName} {
      allow read: if isTeamMember(teamId);
      allow create, update: if canManageWorkspaceContent(teamId)
        && request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && !isBlockedAttachmentType();
      allow delete: if canManageWorkspaceContent(teamId);
    }
  }
}
