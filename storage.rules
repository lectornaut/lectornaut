rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{userId}/{allPaths=**} {
      allow create, read, update, delete: if request.auth.uid == userId;
    }
    match /teams/{teamId}/profilePhoto {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
