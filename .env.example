# ------------------------------------------------------------------------------
# Tauri App Check (Custom Provider)
# ------------------------------------------------------------------------------
# Used by the native Tauri command to sign App Check proof payloads.
TAURI_APP_CHECK_APP_ID=""
TAURI_APP_CHECK_SHARED_SECRET=""

# Cloud Functions runtime-only secrets (set via `firebase functions:secrets:set`, not read from Vite):
# APPCHECK_ALLOWED_APP_ID
# APPCHECK_EXCHANGE_SHARED_SECRET
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# POSTMARK_API_KEY
# GEMINI_API_KEY
# ANTHROPIC_API_KEY
# OPENAI_API_KEY
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET

# Cloud Functions optional runtime env vars (process.env, not secrets):
# EMAIL_FROM_ADDRESS         — override default sender (defaults to "hello@lectornaut.com")
#
# Stripe prices are resolved dynamically by recurring Price lookup_key:
# personal_month, personal_year
# professional_month, professional_year
# business_month, business_year
# enterprise_month, enterprise_year

# Connections (docs/connections-feature.prompt.md) — OAuth Web client id for
# the GIS popup code flow. Same client as the functions secrets
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET. The Tauri
# system-browser flow additionally requires
# http://localhost:7878/connections-callback registered verbatim under this
# client's Authorized redirect URIs (constant in useConnections.ts).
VITE_GOOGLE_OAUTH_CLIENT_ID=""
